<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Polimedica</title>
    <script type="importmap"></script>
    <!--Bootstrap 5.3.3 CSS-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Polimedica.styles.css" asp-append-version="true" />
    <link rel="stylesheet" type="text/css" href="~/css/MyStyle.css">
</head>
<!--  NAVBAR SUPERIOR -->
<body>
    <header class="p-3 text-white bg-success">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
                <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 text-white text-decoration-none"></a>

                <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
                    <li>
                        <button type="button" class="btn btn-sucess" data-bs-toggle="modal" data-bs-target="#telefoneModal">
                            Contato
                        </button>
                    </li>
                    <li>
                        <button type="button" class="btn btn-sucess" data-bs-toggle="modal" data-bs-target="#whatsappModal">
                            WhatsApp
                        </button>
                    </li>
                    <li>
                        <button type="button" class="btn btn-sucess" data-bs-toggle="modal" data-bs-target="#emailModal">
                            E-mail
                        </button>
                    </li>
                    <li>
                        <button type="button" class="btn btn-sucess" data-bs-toggle="modal" data-bs-target="#entregasModal">
                            Entregas
                        </button>
                    </li>
                    <li><a href="#" class="nav-link px-2 text-black">Sobre nós</a></li>
                </ul>

                <div class="text-end">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a type="button" class="btn btn-outline-light" asp-controller="Usuario" asp-action="Logout">Sair</a>
                    }
                    else
                    {
                        <a type="button" class="btn btn-outline-light m-2" asp-controller="Usuario" asp-action="Login">Entrar</a>
                        <a type="button" class="btn btn-outline-light" asp-controller="Usuario" asp-action="RegistroUsuario">Cadastrar-se</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- Modais dos botoes acima-->
    <div class="modal fade" id="telefoneModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success">
                    <h5 class="modal-title text-light" id="telefoneModal">TELEFONE</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>12 3105-1377</p>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="whatsappModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success">
                    <h5 class="modal-title text-light" id="whatsappModal">WHATSAPP</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>12 99766-4716</p>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="emailModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success">
                    <h5 class="modal-title text-light" id="emailModal">WHATSAPP</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>polimedicadovale@contato.com.br</p>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="entregasModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success">
                    <h5 class="modal-title text-light" id="eentregasModal">Nossoas entregas</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>As entregas são feitas de Segunda á Sexta, no periodo da manhã e da tarde.</p>
                    <p>
                        Nosso motorista sai as 9:30h para fazer as entregas da manhã e
                        14:00h para fazer as da tarde, com eventuais entregas ao fim da tarde.
                    </p>
                    <p>As Terça, de manhã, nós entregamos em *** e as Quintas de manhã em ***</p>
                    <p>polimedicadovale@contato.com.br</p>
                </div>
            </div>
        </div>
    </div>

    <!-- NAVBAR INFERIOR -->
    <header>
        <nav class="navbar navbar-expand-lg bg-success-subtle">
            <div class="container-fluid">
                <img src="~/Image/Logo_Polimedica.png" class="img-thumbnail bg-transparent" alt="Logo da Polimedica" width="300">
                <div class="collapse navbar-collapse align-self-end" id="navbarSupportedContent">
                    <ul class="navbar-nav m-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole("Gerente") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Home" asp-action="Index">Produtos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Usuario" asp-action="Dashboard">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Produto" asp-action="CreateProduto">Cria Produtos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Marca" asp-action="CreateMarca">Cria Marca</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Categoria" asp-action="CreateCategoria">Cria Categorias</a>
                                </li>
                            }
                            else if (User.IsInRole("Vendedor"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Home" asp-action="Index">Produtos</a>
                                </li>
                                <!--<li class="nav-item">
                                    <a class="nav-link" asp-controller="Usuario" asp-action="Dashboard">Dashboard</a>
                                </li>-->
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Produto" asp-action="CreateProduto">Cria Produtos</a>
                                </li>
                            }
                            else if (User.IsInRole("Cliente_Pf") || User.IsInRole("Cliente_Pj"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Home" asp-action="Index">Produtos</a>
                                </li>
                            }

                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Produto" asp-action="Index">Produtos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="" asp-action="">Promoções</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="" asp-action="">Para ter em casa</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="" asp-action="">Categorias</a>
                            </li>
                        }
                    </ul>
                    <form class="d-flex" role="search">
                        <input class="form-control me-2" type="search" placeholder="Ex: Meia de compressão" aria-label="Search">
                        <button class="btn btn-outline-success" type="submit">Procurar</button>
                    </form>
                </div>
            </div>
        </nav>
    </header>
    <!-- BODY -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <!-- FOOTER -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - Polimedica - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!--Bootstrap 5.3.3 JavaScript-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
