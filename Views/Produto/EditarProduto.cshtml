@using Polimedica.ViewModel;
@model EditProdutoViewModel


<title>@ViewData["Title"] - Edição de produto</title>

<form method="post" asp-action="EditarProduto" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="NomeProduto" class="form-label">Produto</label>
        <input asp-for="NomeProduto" class="form-control" placeholder="Nome do produto">
        <span asp-validation-for="NomeProduto" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DescricaoProduto" class="form-label">Descrição do produto</label>
        <input asp-for="DescricaoProduto" class="form-control" placeholder="Descrição do produto">
        <span asp-validation-for="DescricaoProduto" class="text-danger"></span>
    </div>
    <br />
    <div>
        <h5>Marcas</h5>
    </div>

    @if (ViewBag.marcaVb != null)
    {
        @foreach (var item in ViewBag.marcaVb)
        {
            <div class="form-check" id="checkboxMarca">
                <input class="form-check-input" type="checkbox" name="MarcaId" id="@item.MarcaId" checked="@item.IsChecked" value="@item.MarcaId" />
                <label class="form-check-label">
                    @item.MarcaNome
                </label>
            </div>
        }
        <a class="nav-link btn btn-outline-info btn-lg" asp-controller="Marca" asp-action="CreateMarca">Criar nova Marca</a>
    }
    else
    {
        <div>
            <a class="nav-link btn btn-outline-success btn-lg" asp-controller="Marca" asp-action="CreateMarca">Criar Marca</a>
        </div>
    }

    <div class="form-group">
        <label asp-for="Preco" class="form-label">Preço unitário</label>
        <input asp-for="Preco" class="form-control" placeholder="Preço" type="text">
    </div>
    <br />
    <div>
        <h5>Categorias</h5>
    </div>

    @if (ViewBag.categoriaVb != null)
    {
        @foreach (var item in ViewBag.categoriaVb)
        {
            <div class="form-check" id="checkboxCategoria">
                <input class="form-check-input" type="checkbox" name="CategoriaId" id="@item.CategoriaId" checked="@item.IsChecked" value="@item.CategoriaId" />
                <label oncancel="form-check-label">
                    @item.CategoriaNome
                </label>
            </div>
        }
        <a class="nav-link btn btn-outline-info btn-lg" asp-controller="Categoria" asp-action="CreateCategoria">Criar nova Categoria</a>
    }
    else
    {
        <div>
            <a class="nav-link btn btn-outline-success btn-lg" asp-controller="Categoria" asp-action="CreateCategoria">Criar Categoria</a>
        </div>
    }
    <br />
    <div class="form-group">
        @if(Model.Imagem1 == "" || Model.Imagem1 == null)
        {
            <img src="~/Data/Image/LogoPolimedica.jpg" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
        }
        else
        {
            <img src="@Model.Imagem1" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
        }
        <label asp-for="Imagem1" class="form-label">@Model.Imagem1</label>
        <input asp-for="IImagem1" type="file" class="form-control">
    </div>
    <br />
    <div class="col-md-6">
        @if (Model.Imagem2 == "" || Model.Imagem2 == null)        {
            <img src="~/Data/Image/LogoPolimedica.jpg" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
        }
        else
        {
            <img src="@Model.Imagem2" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
        }
        <label asp-for="Imagem2" class="form-label">@Model.Imagem2</label>
        <input asp-for="IImagem2" type="file" class="form-control">
    </div>
    <br />
    <div class="col-md-6">
        @if (Model.Imagem3 == "" || Model.Imagem3 == null)
        {
            <img src="~/Data/Image/LogoPolimedica.jpg" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
        }
        else
        {
            <img src="@Model.Imagem3" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
        }
        <label asp-for="Imagem3" class="form-label">@Model.Imagem3</label>
        <input asp-for="IImagem3" type="file" class="form-control">
    </div>
    <br />
    <div class="col-md-6">
        @if (Model.Imagem4 == "" || Model.Imagem4 == null)
        {
            <img src="~/Data/Image/LogoPolimedica.jpg" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
        }
        else
        {
            <img src="@Model.Imagem4" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
        }
        <label asp-for="Imagem4" class="form-label">@Model.Imagem4</label>
        <input asp-for="IImagem4" type="file" class="form-control">
    </div>
    <br />
    <div class="col-md-6">
        @if (Model.Imagem5 == "" || Model.Imagem5 == null)
        {
            <img src="~/Data/Image/LogoPolimedica.jpg" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
        }
        else
        {
            <img src="@Model.Imagem5" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
        }
        <label asp-for="Imagem5" class="form-label">@Model.Imagem5</label>
        <input asp-for="IImagem5" type="file" class="form-control">
    </div>
    <br />
    <div class="col-md-6">
        <input asp-for="Ativo" checked="@Model.Ativo" class="form-check-input" type="checkbox">
        <label asp-for="Ativo" class="form-check-label" for="gridCheck">
            Ativo
        </label>
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Salvar</button>
</form>