@model Polimedica.Models.Produto

<div>
    <section class="py-2 text-center container">
        <div class="row py-lg-5">
            <div class="col-lg-6 col-md-8 mx-auto">
                <h1 class="fw-light">Detalhes do Produto</h1>
                <p class="lead text-muted">Confira os detalhes do produto abaixo:</p>
            </div>
        </div>
    </section>

    <section class="container">
        <div class="row">
            <div class="col-5">
                <div>
                    <button type="button" class="btn btn-sucess" data-bs-toggle="modal" data-bs-target="#imagem1">
                        @if (Model.Imagem1 == null || Model.Imagem1 == "")
                        {
                            <img src="~/Image/Logo_Polimedica.png" class="img-fluid" alt="@Model.NomeProduto">
                        }
                        else
                        {
                            <img src="@Model.Imagem1" class="img-fluid" alt="@Model.NomeProduto">
                        }
                    </button>
                </div>
            </div>
            <div class="col-2">
                <div>
                    <button type="button" class="btn btn-sucess" data-bs-toggle="modal" data-bs-target="#imagem2">
                        @if (Model.Imagem2 == null || Model.Imagem2 == "")
                        {
                            <img src="~/Image/Logo_Polimedica.png" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
                        }
                        else
                        {
                            <img src="@Model.Imagem2" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
                        }
                    </button>
                    <button type="button" class="btn btn-sucess" data-bs-toggle="modal" data-bs-target="#imagem3">
                        @if (Model.Imagem3 == null || Model.Imagem3 == "")
                        {
                            <img src="~/Image/Logo_Polimedica.png" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
                        }
                        else
                        {
                            <img src="@Model.Imagem3" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
                        }
                    </button>
                    <button type="button" class="btn btn-sucess" data-bs-toggle="modal" data-bs-target="#imagem4">
                        @if (Model.Imagem4 == null || Model.Imagem4 == "")
                        {
                            <img src="~/Image/Logo_Polimedica.png" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
                        }
                        else
                        {
                            <img src="@Model.Imagem4" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
                        }
                    </button>
                    <button type="button" class="btn btn-sucess" data-bs-toggle="modal" data-bs-target="#imagem5">
                        @if (Model.Imagem5 == null || Model.Imagem5 == "")
                        {
                            <img src="~/Image/Logo_Polimedica.png" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
                        }
                        else
                        {
                            <img src="@Model.Imagem5" class="mh-100" style="width: 100px; height:120px;" alt="@Model.NomeProduto">
                        }
                    </button>
                </div>
            </div>
            <div class="col-5">
                <div><h1>@Model.NomeProduto</h1></div>
                <div><p><h3>@Model.DescricaoProduto</h3></p></div>
                @* <div><h2>@Model.Preco</h2></div> *@
                
                @if(User.Identity.IsAuthenticated &&
                                User.IsInRole("Admin") ||
                                User.IsInRole("Gerente") ||
                               User.IsInRole("Vendedor"))
                {
                    @if (Model.Ativo)
                    {
                        <div><p><h4>Este produto está ativo no site</h4></p></div>
                        <div><p><h4>E seu preço está cadastrado com o valor de @Model.Preco</h4></p></div>
                    }
                    else
                    {
                        <div><p><h4 style="color: red;">Este produto NÃO está ativo no site</h4></p></div>
                        <div><p><h4>E seu preço está cadastrado com o valor de @Model.Preco</h4></p></div>
                    }
                }

                @*   <div>
                    @if(ViewBag.categoriaVb != null)
                    {
                        <h4>Categorias:</h4>
                    }
                </div> *@
                <div>
                    @if (ViewBag.marcaDetalheVb != null && ((IEnumerable<dynamic>)ViewBag.marcaDetalheVb).Any())
                    {
                        <h4>Marcas :</h4>
                        <table class="table">
                            @foreach (var item in ViewBag.marcaDetalheVb)
                            {
                                <tr>
                                    <td>@item.NomeMarca</td>
                                </tr>
                            }
                        </table>
                    }
                </div>
            </div>
        </div>
    </section>
    <section>
        <div class="text-end">
            @if (User.Identity.IsAuthenticated &&
                        User.IsInRole("Admin") ||
                        User.IsInRole("Gerente") ||
                        User.IsInRole("Vendedor"))
            {
                <a type="btn btn-success" asp-controller="Produto" asp-action="EditarProduto" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
                <a type="btn btn-success" asp-controller="Produto" asp-action="Index" class="btn btn-primary">Voltar</a>
            }
            else
            {
                <a type="btn btn-success" asp-controller="Produto" asp-action="Index" class="btn btn-primary">Voltar</a>
            }
        </div>
    </section>



    <!-- Modais dos botoes das imagens-->
    <div class="modal fade" id="imagem1" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success">
                    <h5 class="modal-title text-light" id="telefoneModal">@Model.NomeProduto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (Model.Imagem1 == null || Model.Imagem1 == "")
                    {
                        <img src="~/Image/Logo_Polimedica.png" class="mh-100" style="width:100%; height:100%;" alt="@Model.NomeProduto">
                    }
                    else
                    {
                        <img src="@Model.Imagem1" class="mh-100" style="width: 100%; height:100%;" alt="@Model.NomeProduto">
                    }
                </div>
            </div>
        </div>
    </div>
