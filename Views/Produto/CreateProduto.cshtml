@using Polimedica.ViewModel;
@model CreateProdutoViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
<title>@ViewData["Title"] - Cadastro de produto</title>

<form method="post" asp-action="CreateProduto" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="NomeProduto" class="form-label">Produto</label>
        <input asp-for="NomeProduto" class="form-control" placeholder="Nome do produto">
        <span asp-validation-for="NomeProduto" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DescricaoProduto" class="form-label">Descrição do produto</label>
        <input asp-for="DescricaoProduto" class="form-control" placeholder="Descrição do produto">
        <span asp-validation-for="DescricaoProduto" class="text-danger"></span>
    </div>
    @if (ViewBag.marcaVb != null){
        @foreach (var item in ViewBag.marcaVb)
        {
            <div class="form-check" id="checkboxMarca">
                <input class="form-check-input" type="checkbox" name="MarcaId" id="@item.Id" value="@item.Id">
                    <label class="form-check-label">
                        @item.NomeMarca - @item.Id
                    </label>
            </div>
        }
        <a class="nav-link btn btn-outline-info btn-lg" asp-controller="Marca" asp-action="CreateMarca">Criar nova marca</a>
    }
    else
    {
        <div>
            <a class="nav-link btn btn-outline-success btn-lg" asp-controller="Marca" asp-action="CreateMarca">Criar Marca</a>
        </div>
    }
    <div class="form-group">
        <label asp-for="Preco" class="form-label">Preço unitário</label>
        <input asp-for="Preco" class="form-control" placeholder="Preço" type="text">
    </div>
    @if(ViewBag.categoriaVb != null){
        @foreach (var item in ViewBag.categoriaVb)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="CategoriaId" id="@item.Id" value="@item.Id">
                <label class="form-check-label">
                    @item.NomeCategoria - @item.Id
                </label>
            </div>
        }
        <a class="nav-link btn btn-outline-info btn-lg" asp-controller="Categoria" asp-action="CreateCategoria">Criar nova categoria</a>
    }else{
        <div>
            <a class="nav-link btn btn-outline-success btn-lg" asp-controller="Categoria" asp-action="CreateCategoria">Criar Categoria</a>
        </div>
    }
    <div class="form-group">
        <label asp-for="Imagem1" class="form-label">Imagem Principal</label>
        <input asp-for="Imagem1" type="file" class="form-control">
    </div>
    <div class="col-md-6">
        <label asp-for="Imagem2" class="form-label">Imagem2</label>
        <input asp-for="Imagem2" type="file" class="form-control">
    </div>
    <div class="col-md-6">
        <label asp-for="Imagem3" class="form-label">Imagem3</label>
        <input asp-for="Imagem3" type="file" class="form-control">
    </div>
    <div class="col-md-6">
        <label asp-for="Imagem4" class="form-label">Imagem4</label>
        <input asp-for="Imagem4" type="file" class="form-control">
    </div>
    <div class="col-md-6">
        <label asp-for="Imagem5" class="form-label">Imagem5</label>
        <input asp-for="Imagem5" type="file" class="form-control">
    </div>
    <div class="col-md-6">
        <input asp-for="Ativo" class="form-check-input" type="checkbox">
        <label asp-for="Ativo" class="form-check-label" for="gridCheck">
            Ativo
        </label>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
</form>