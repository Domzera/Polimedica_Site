@using Polimedica.ViewModel
@model CreateMarcaViewModel

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<title>@ViewData["Title"] - Crinado Marca</title>

<form method="post" asp-action="CreateMarca" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="NomeMarca" class="form-label">Nome da Marca</label>
        <input asp-for="NomeMarca" class="form-control" placeholder="Nome da Marca">
        <span asp-validation-for="NomeMarca" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DescricaoMarca" class="form-label">Descrição da Marca</label>
        <input asp-for="DescricaoMarca" class="form-control" placeholder="Descrição da Marca">
        <span asp-validation-for="DescricaoMarca" class="text-danger"></span>
    </div>
    <br />
    <br />
    <button type="submit" class="btn btn-primary">Salvar</button>
</form>
