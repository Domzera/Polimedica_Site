@using Polimedica.ViewModel;
@model UserRegisterViewModel;

<div class="container">
    <div class="row">
        <div class="col">
        </div>
        <div class="col-6">
            <form method="post" asp-action="RegistroUsuario">
                <div class="form-floating mb-3 mt-4">
                    <input asp-for="Email" class="form-control" placeholder="E-mail">
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Name" class="form-control" placeholder="Primeiro Nome">
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="SobreNome" class="form-control" placeholder="Sobrenome">
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Password" type="password" oninput="check()" id="Password" class="form-control" placeholder="Senha">
                    <br />
                    <h5 id="Password1" style="font-size:11px">A senha deve ter pelomenos uma letra minuscula</h5>
                    <h5 id="Password2" style="font-size:11px">A senha deve ter pelomenos uma letra maiuscula</h5>
                    <h5 id="Password3" style="font-size:11px">A senha deve ter pelomenos um número</h5>
                    <h5 id="Password4" style="font-size:11px">A senha deve ter um caracter especial</h5>
                    <h5 id="Password5" style="font-size:11px">A senha deve ter no minimo 6 caracteres</h5>
                </div>
                <input type="submit" class="btn btn-success mt-4" value="Cadastre-se"/>
            </form>
        </div>
        <div class="col">
        </div>
    </div>
</div>

<script>
        function check() {
        var password = document.getElementById("Password").value;

        // Requisitos da senha
        var hasUpperCase = /[A-Z]/.test(password);
        var hasLowerCase = /[a-z]/.test(password);
        var hasNumber = /[0-9]/.test(password);
        var hasSpecialChar = /[\W_]/.test(password); // \W inclui tudo que não é letra ou número

        document.getElementById("Password1").innerText = "A senha deve conter pelomenos um letra maiúscula" + (hasUpperCase ? " ✅ " : "");
        document.getElementById("Password2").innerText = "A senha deve conter pelomenos um minuscula" + (hasLowerCase ? " ✅ " : "");
        document.getElementById("Password3").innerText = "A senha deve conter pelomenos um número" + (hasNumber ? " ✅ " : "");
        document.getElementById("Password4").innerText = "A senha deve conter pelomenos um caracter especial" + (hasSpecialChar ? " ✅ " : "");
        document.getElementById("Password5").innerText = "A senha deve ter no minimo 6 caracteres" + (password.length >= 6 ? " ✅ " : "");
    }

</script>



