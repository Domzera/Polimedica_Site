@using Polimedica.ViewModel
@model LoginViewModel

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@{
    ViewData["Titel"] = "login";
}
<div class="row">
    <div class="col-md-6 offset-3">
        <p>
            <h4>Entrar na conta</h4>
        </p>
        @if (ViewBag.UserMessage != null)
        {
            <div class="col-md-12 alert alert-danger">
                <span><b>Usuário não encontrado</b></span>
            </div>
        }
        @if (ViewBag.SenhaMessage != null)
        {
            <div class="col-md-12 alert alert-danger">
                <span><b>Senha invalida</b></span>
            </div>
        }
        <div class="row">
            <div class="col-md-8 offset-2">
                <form asp-action="Login">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email" class="form-control">
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Password" class="control-label"></label>
                        <input asp-for="Password" type="password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="form-group">
                        <input class="btn btn-success float right" type="submit" value="Entrar" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>