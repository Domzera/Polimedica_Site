@using Polimedica.ViewModel
@model CreateCategoriaViewModel

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<title>@ViewData["Title"] - Crinado Categoria</title>

<form method="post" asp-action="CreateCategoria" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Nome" class="form-label">Nome da Categoria</label>
        <input asp-for="Nome" class="form-control" placeholder="Nome da Categoria">
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Descricao" class="form-label">Descrição da Categoria</label>
        <input asp-for="Descricao" class="form-control" placeholder="Descrição da Categoria">
        <span asp-validation-for="Descricao" class="text-danger"></span>
    </div>
    <br />
    <br />
    <button type="submit" class="btn btn-primary">Salvar</button>
</form>
